# ==============================================================================
# FreeRADIUS EAP Module Configuration (mods-available/eap) — Post-Quantum Variant
# EAP-TLS over TLS 1.3 with hybrid ML-KEM key establishment ONLY
# ==============================================================================
# Experimental deployment. Supplicants that cannot negotiate TLS 1.3 with a
# hybrid post-quantum key exchange group are rejected during the handshake;
# there is deliberately NO classical (EC)DHE fallback.
#
# Requires OpenSSL >= 3.5 (native ML-KEM). Authentication remains classical
# (ECDSA P-384 certificates) — only the ephemeral key exchange is PQ-secure.
# ==============================================================================
eap {
    # Default to TLS for certificate-based 802.1X
    default_eap_type = tls

    # EAP session expiration timeout
    timer_expire = 60

    # Reject unsupported/unknown EAP types
    ignore_unknown_eap_types = no

    max_sessions = ${max_requests}

    # --------------------------------------------------------------------------
    # Common TLS Configuration
    # --------------------------------------------------------------------------
    tls-config tls-common {
        # How these settings map onto the TLS handshake
        # ----------------------------------------------------------------------
        # In a TLS handshake the server and the supplicant agree on several
        # things independently, and each is governed by its own setting:
        #
        #   protocol version ................... tls_min_version / tls_max_version
        #   cipher suite (record encryption) ... cipher_suites
        #   key exchange group ................. ecdh_curve
        #   handshake signature algorithm ...... sigalgs_list
        #
        # Each side also presents a certificate chain: the server's own
        # (certificate_file), and the supplicant's, which must lead to ca_file.
        # Across all of these, OpenSSL's security level (@SECLEVEL in
        # cipher_list) sets a minimum strength. Settings made here apply to
        # EAP-TLS only, not process-wide: other TLS listeners in this server
        # (such as RadSec) state their own policy.

        # --- Certificates and trust -------------------------------------------

        # The server's own certificate and its private key (one PEM file from
        # the freeradius-certs Secret), presented to every supplicant.
        private_key_file = /etc/raddb/certs/server.pem
        certificate_file = /etc/raddb/certs/server.pem

        # The trust anchor for supplicants: a client certificate is accepted
        # only if its chain leads to this CA (the user-device root CA).
        # ca_path (a directory of CAs) is deliberately left unset, to avoid its
        # directory permission checks.
        ca_file = /etc/raddb/certs/ca.pem

        # --- Protocol version -------------------------------------------------

        # TLS 1.3 only, as EAP-TLS for TLS 1.3 is specified (RFC 9190). The
        # hybrid groups in ecdh_curve exist only in TLS 1.3, so they also rule
        # out TLS 1.2 on their own, not that we'd have any reason to use them.
        tls_min_version = "1.3"
        tls_max_version = "1.3"

        # --- Cipher suite -----------------------------------------------------

        # A TLS 1.3 cipher suite names only two things: the authenticated
        # encryption that protects the records after the handshake (AES-256-GCM)
        # and the hash used to derive keys from the handshake secrets (SHA-384).
        # Key exchange and signatures are negotiated separately, below. This is
        # the only suite our server offers. Supplicants offering other values like AES-128-GCM,
        # ChaCha20 or AES-CCM are refused during the handshake.
        cipher_suites = "TLS_AES_256_GCM_SHA384"

        # --- Key exchange -----------------------------------------------------

        # Despite its name, this is the list of key exchange groups. In
        # TLS 1.3 the group is used only for the ephemeral key exchange that
        # produces the session secrets; it says nothing about certificates.
        #
        # A hybrid group runs a classical elliptic-curve exchange and an
        # ML-KEM key encapsulation together, and feeds both shared secrets
        # into the TLS key derivation, so the session stays confidential
        # unless both are broken. If one is broken, the exchange is as strong
        # as the other one alone:
        #   - A quantum computer breaks every elliptic-curve exchange, leaving
        #     ML-KEM to protect the session.
        #   - ML-KEM is far newer than X25519, so a flaw in its design or an
        #     implementation is the likelier failure. The elliptic-curve half
        #     then still protects against classical attackers, though not
        #     against a quantum computer.
        #
        # Strength of each half (bits = log2 of the cost of the best known
        # attack; NIST rates post-quantum schemes in categories instead, each
        # "as hard to break as finding an AES key of that size", for both
        # classical and quantum attackers):
        #   X25519       ~128 bits classical; none against a quantum computer
        #   P-384        ~192 bits classical; none against a quantum computer
        #   ML-KEM-768   NIST category 3 (comparable to AES-192)
        #   ML-KEM-1024  NIST category 5 (comparable to AES-256)
        # With X25519MLKEM768 the 192-bit level rests on ML-KEM-768 alone: if
        # it fell, the exchange would drop to X25519's 128 bits against
        # classical attackers and nothing against quantum ones.
        # SecP384r1MLKEM1024 would retain 192 bits against classical attackers
        # even then, but Apple devices don't offer it.
        #
        # Hybrid groups ONLY (no classical fallback), strongest first:
        #   - SecP384r1MLKEM1024 : P-384 + ML-KEM-1024
        #   - X25519MLKEM768     : X25519 + ML-KEM-768 (the only PQ group
        #                          Apple clients currently offer)
        # Supplicants offering only classical groups fail with "no suitable key
        # share".
        ecdh_curve = "SecP384r1MLKEM1024:X25519MLKEM768"

        # When both sides support several options, use the server's order, not
        # the supplicant's. With a single cipher suite, this matters only for
        # the group: a supplicant sending key shares for both groups gets
        # SecP384r1MLKEM1024 even if it prefers X25519MLKEM768. A supplicant
        # that sends only an X25519MLKEM768 key share (as Apple devices do) still gets
        # X25519MLKEM768, because OpenSSL avoids an extra round trip
        # (HelloRetryRequest) when an acceptable key share is already present.
        cipher_server_preference = yes

        # --- Handshake signatures ---------------------------------------------

        # The signature algorithms allowed for the signatures made DURING the
        # handshake: the server signing the handshake with its private key, and
        # the supplicant proving it holds the private key of its certificate
        # (CertificateVerify). In TLS 1.3 a signature scheme names the
        # algorithm, the curve and the hash together: this one is ECDSA on
        # P-384 with SHA-384 (which is CNSA 1.0-compliant).
        # A device whose key is on another curve (e.g. a P-256 Secure Enclave key)
        # cannot produce an acceptable signature and is refused. This does not cover
        # the signatures ON certificates, made by a CA when it issued them (see security level notes below).
        sigalgs_list = "ecdsa_secp384r1_sha384"

        # --- Security level ---------------------------------------------------

        # OpenSSL's security level is a minimum strength applied across the
        # whole connection: keys and signatures in either side's certificate
        # chain, the key exchange group, the cipher and the handshake
        # signatures. Level 4 (which we'r setting here) is equivalent to 192 bits.
        # It is the only setting here that checks the signatures ON certificates: 
        # a supplicant certificate that its CA signed with SHA-256 is refused.
        # It overlaps with the settings above (it also refuses P-256 keys and
        # AES-128 suites), but allows stronger options that they exclude,
        # such as ChaCha20.
        #
        # FreeRADIUS has no configuration option of its own for the security
        # level (there is no setting like "security_level = 4"). The only way
        # to set it is through cipher_list, which FreeRADIUS hands unchanged to
        # OpenSSL as a "cipher string". That string mixes two kinds of thing:
        #   - cipher suite names, which choose TLS 1.2 (and older) suites
        #     only. TLS 1.3 suites come from cipher_suites above instead, so the
        #     suite named here is never used on this TLS 1.3-only server.
        #     OpenSSL still refuses a string that names no TLS 1.2 suite, so
        #     one must be named; we have set our EC CNSA suite below, so that it would
        #     still be the only option if TLS 1.2 were ever allowed here.
        #   - commands, which set options for the whole TLS context, TLS 1.3
        #     included. "@SECLEVEL=4" is one. A leading "SUITEB128" or
        #     "SUITEB192" is another, and MUST NEVER be used here: it switches
        #     OpenSSL into Suite B mode, which replaces ecdh_curve with
        #     classical P-384 and discards the rest of the string,
        #     "@SECLEVEL=4" included.
        cipher_list = "ECDHE-ECDSA-AES256-GCM-SHA384:@SECLEVEL=4"

        # --- Session resumption -----------------------------------------------

        # Resumption lets a returning supplicant skip the full handshake by
        # reusing secrets from an earlier session. It is disabled, so every
        # EAP authentication is a full handshake. On this TLS 1.3 server,
        # resumption couldn't be used anyway with FreeRADIUS 3.2.10 (tested in
        # a lab with resumption on):
        #   - The TLS side resumes: the supplicant's pre-shared key is
        #     accepted, with a fresh hybrid ML-KEM key exchange alongside it.
        #   - But every resumed authentication is then rejected. FreeRADIUS
        #     restores the cached certificate attributes while handling the
        #     ClientHello, and they are gone by the time check-eap-tls runs
        #     (after the supplicant's final ACK), so the policy sees no
        #     certificate CN and refuses (cn=""). It fails closed, but the
        #     device has to start again with a full handshake.
        # Even if that were fixed, disabling resumption would still give:
        #   - Certificate checks every time. A resumed session skips verifying
        #     the certificate chain against ca_file.
        #   - The supplicant proves every time that it holds its certificate's
        #     private key (CertificateVerify). On resumption it proves only
        #     that it knows the resumption key, which software on the device
        #     holds and which could be copied off it. This protects against
        #     an attacker who copies that key and then loses access to the
        #     device: without resumption, the copy is useless. Of course, it
        #     doesn't mean much if an attacker has persistence on the device,
        #     since they can just keep stealing each new resumption key, nor
        #     does it mean much while client certificate private keys are
        #     also accessible from software (which ours are for now, since
        #     they're not generated on the Secure Enclave (yet)). Once they
        #     are, malicious software could still use the Secure Enclave as an
        #     oracle to complete new handshakes, but only for as long as it
        #     keeps access to the device. Alas.
        #   - Forward secrecy that does not depend on a default. TLS 1.3
        #     resumes with a pre-shared key (PSK) derived from the earlier
        #     session. To resume at all, FreeRADIUS 3.2.10 must write each
        #     session, PSK included, to disk (persist_dir) or hand it to a
        #     cache virtual server; the supplicant gets only a ticket that
        #     names the stored session (FreeRADIUS never issues stateless,
        #     encrypted tickets). In "psk_ke" mode the resumed session's keys
        #     come from that PSK alone, so anyone who later obtains it (from
        #     the server's store or the device) could decrypt every resumed
        #     session they recorded. In "psk_dhe_ke" mode, a fresh key exchange
        #     is added (here a hybrid ML-KEM one), which keeps forward secrecy.
        #     OpenSSL accepts only psk_dhe_ke by default. With resumption off,
        #     every session makes a new key exchange regardless, and no PSK is
        #     stored to be stolen.
        # For what it's worth, each of these benefits is fairly niche on its
        # own. Together, though, they're enough to keep resumption off: the
        # only cost is a full handshake for every authentication.
        #
        # This applies to EAP authentications, not to every Wi-Fi association.
        # The Wi-Fi layer has its own resumption: an AP may cache the PMK
        # (PMKSA caching) and let a device reconnect without contacting this
        # server at all. That cache's lifetime on the AP, and any
        # Session-Timeout sent in the Access-Accept, limit how long a device
        # removed from the authorize list can stay connected.
        cache {
            enable = no
        }
    }

    # --------------------------------------------------------------------------
    # EAP-TLS Submodule
    # --------------------------------------------------------------------------
    tls {
        tls = tls-common

        # Admission and VLAN assignment from the verified client certificate
        # CN, failing closed (supplicants use an anonymous outer identity);
        # see sites/check-eap-tls
        virtual_server = check-eap-tls
    }
}
