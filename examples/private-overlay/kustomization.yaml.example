apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization

namespace: freeradius-experimentation

resources:
  # In your private repository, pull directly from GitHub:
  # - github.com/andrewnicolalde/homelab-NAC//k8s?ref=main
  # For local testing relative to this repository:
  - ../../k8s
  # Optional: post-quantum (TLS 1.3 + hybrid ML-KEM) deployment. Shares the
  # certs Secret and clients.conf/authorize ConfigMap generated below.
  # - github.com/andrewnicolalde/homelab-NAC//k8s-pqc?ref=main
  # - ../../k8s-pqc

# Overrides the base ConfigMap with your actual private network definitions
configMapGenerator:
  - name: freeradius-config
    # merge keeps the base's eap and shared check-eap-tls/cert_vlan
    # policy; radiusd will not start without them
    behavior: merge
    files:
      - clients.conf=./clients.conf
      - authorize=./authorize

# Overrides the base Secret with your actual PKI certificates and private keys
secretGenerator:
  - name: freeradius-certs
    behavior: replace
    files:
      - server.pem=./certs/radius-server/server.pem
      - ca.pem=./certs/user-client-devices/user_root_ca.crt
