# ==============================================================================
# Certificate Authority Environment Configuration (EXAMPLE)
# ==============================================================================
# Copy this file to 'certs.env' in your private repository to define your site's
# server IP, client identity, and Root CA name.

RADIUS_IP="10.50.0.100"
CLIENT_IDENTITY="client-device-01"
ROOT_CA_NAME="Enterprise Root CA"
AP_IDENTITY="unifi-aps"

# Optional additional Subject Alternative Names (SANs) for the server cert:
# ADDITIONAL_SANS=("radius.internal.lan" "10.50.0.5")

# Optional YubiKey Hardware Root of Trust mode (defaults to false for software CA):
# USE_YUBIKEY="true"
# SLOT_SERVER_CA="9c"
# SLOT_USER_CA="9d"
# SLOT_UNIFI_CA="82"
