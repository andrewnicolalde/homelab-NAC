# ==============================================================================
# Certificate Authority Environment Configuration (EXAMPLE)
# ==============================================================================
# Copy this file to 'certs.env' in your private repository to define your site's
# server parameters, authenticator identities, and Root CA names.

# FreeRADIUS Server Hostname / FQDN (Subject Common Name & SAN)
RADIUS_SERVER_NAME="radius.internal.example.com"

# Root CA and Authenticator Identity
ROOT_CA_NAME="Enterprise Root CA"
AP_IDENTITY="unifi-aps"

# Optional additional Subject Alternative Names (SANs) for the server cert:
# ADDITIONAL_SANS=("radius.internal.lan")

# Wi-Fi SSID for Apple Configuration Profile (.mobileconfig) generation:
# WIFI_SSID="ENTERPRISE-WIFI"

# YubiKey Hardware Root of Trust mode (defaults to false for software CA):
# USE_YUBIKEY="true"
# SLOT_RADIUS_SERVER_CA="9c"                          # RADIUS Server Root CA
# SLOT_USER_CLIENT_DEVICES_CA="9d"                    # User Endpoints Root CA
# SLOT_NETWORK_INFRASTRUCTURE_AUTHENTICATORS_CA="82"  # Network Infrastructure Authenticators Root CA
