# ==============================================================================
# FreeRADIUS linelog Module Instances (mods-enabled/cert_log)
# One log line per EAP-TLS admission decision, on stdout
# ==============================================================================
# Shared by the classical (k8s/) and post-quantum (k8s-pqc/) deployments.
# Called by the check-eap-tls virtual server (see sites/check-eap-tls), which
# only runs after the client certificate chain has been verified.
#
# radiusd runs without debug output (-X or any -x), because every debug level
# prints each Access-Accept's MS-MPPE-Send/Recv-Key: the key material the AP
# derives the Wi-Fi session keys from. Without debug output nothing records
# which device was admitted, so these lines do, logging only the fields named
# below.
#
# src= is the address the request arrived from: over RadSec, the AP's own TCP
# connection, so it records which AP relayed a request even though every AP
# presents the same certificate. nas= and called= are what the AP says about
# itself; src= backs them up.
#
# Only authenticated or server-side values are logged: the certificate fields
# (signed by the trusted CA), attributes set by the authenticator (protected
# by the RADIUS shared secret; ssid= is the SSID part of Called-Station-Id,
# split out by check-eap-tls) and the negotiated TLS parameters. The claimed
# outer identity (User-Name) is left out: it is chosen by the supplicant, and
# a newline in it would let a device forge log lines.
#
# cert_log_plaintext warns once per EAP-TLS authentication that arrived over
# plain UDP RADIUS instead of RadSec (see sites/check-eap-tls), naming the
# RADIUS client (from clients.conf) and the address it came from.
# ==============================================================================
linelog cert_log_admitted {
    filename = /dev/stdout
    format = "%t : Auth: EAP-TLS admitted: cn=\"%{TLS-Client-Cert-Common-Name}\" serial=%{TLS-Client-Cert-Serial} issuer=\"%{TLS-Client-Cert-Issuer}\" vlan=%{reply:Tunnel-Private-Group-Id} mac=%{outer.request:Calling-Station-Id} src=%{outer.request:Packet-Src-IP-Address} nas=\"%{outer.request:NAS-Identifier}\" called=\"%{outer.request:Called-Station-Id}\" ssid=\"%{Called-Station-SSID}\" tls=\"%{outer.session-state:TLS-Session-Version}\" cipher=%{outer.session-state:TLS-Session-Cipher-Suite}"
}

linelog cert_log_rejected {
    filename = /dev/stdout
    format = "%t : Auth: EAP-TLS rejected, no authorize entry for certificate: cn=\"%{TLS-Client-Cert-Common-Name}\" serial=%{TLS-Client-Cert-Serial} issuer=\"%{TLS-Client-Cert-Issuer}\" mac=%{outer.request:Calling-Station-Id} src=%{outer.request:Packet-Src-IP-Address} nas=\"%{outer.request:NAS-Identifier}\" called=\"%{outer.request:Called-Station-Id}\" ssid=\"%{Called-Station-SSID}\""
}

linelog cert_log_plaintext {
    filename = /dev/stdout
    format = "%t : Auth: WARNING: RADIUS over plaintext UDP, not RadSec: client=%{client:shortname} src=%{outer.request:Packet-Src-IP-Address} nas=\"%{outer.request:NAS-Identifier}\" port=%{outer.request:Packet-Dst-Port}. The Wi-Fi session keys in its Access-Accept are protected only by the RADIUS shared secret"
}
