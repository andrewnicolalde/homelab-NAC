# ==============================================================================
# FreeRADIUS Clients Configuration Template (EXAMPLE)
# Copy this file to 'clients.conf' (which is gitignored) and insert your secrets.
# Defines trusted Network Access Servers (NAS) / Authenticators (APs, Switches)
# ==============================================================================

# 1. Localhost (for local diagnostic testing with radtest / eapol_test)
client localhost {
    ipaddr = 127.0.0.1
    secret = 'CHANGE_ME_LOCAL_TEST_SECRET'
    require_message_authenticator = no
    nas_type = other
}

# 2. Homelab Authenticators (UniFi APs and Switches)
# The secret here MUST match the RADIUS Secret entered in your UniFi RADIUS Profile.
client homelab_network {
    ipaddr = 10.1.0.0/24
    secret = 'CHANGE_ME_TO_STRONG_48_CHAR_SECRET'
    require_message_authenticator = yes
    nas_type = other
}

# 3. Test Runner / Management Subnet (for testing EAP-TLS directly via eapol_test)
client workstation_test {
    ipaddr = 10.10.10.0/24
    secret = 'CHANGE_ME_TO_STRONG_48_CHAR_SECRET'
    require_message_authenticator = yes
    nas_type = other
}
