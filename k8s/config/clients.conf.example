# ==============================================================================
# FreeRADIUS Clients Configuration Template (EXAMPLE)
# Copy this file to 'clients.conf' (which is gitignored). Shared secrets are NOT
# stored here: they are read from environment variables ($ENV{...}), which the
# Deployments load from the 'freeradius-client-secrets' Secret. FreeRADIUS
# refuses to start if a referenced variable is unset or empty.
# Defines trusted Network Access Servers (NAS) / Authenticators (APs, Switches)
# ==============================================================================

# 1. Network Authenticators (APs and Switches)
# The secret (RADIUS_SECRET_AUTHENTICATORS) MUST match the RADIUS Secret entered in
# your AP/switch RADIUS Profile.
client network_authenticators {
    ipaddr = 10.1.0.0/24
    secret = $ENV{RADIUS_SECRET_AUTHENTICATORS}
    require_message_authenticator = yes
    nas_type = other
}

# 1b. The same authenticators over RadSec (TCP 2083, sites-enabled/radsec).
# Only the RadSec listener reads this list ('clients = radsec'); the UDP
# listeners use the clients above. The address must match the AP's real
# source address, which the Service preserves (externalTrafficPolicy: Local).
# "radsec" is the fixed secret the RadSec standard prescribes: the TLS
# connection, with the AP's certificate, protects the traffic instead.
clients radsec {
    client authenticators_radsec {
        ipaddr = 10.1.0.0/24
        proto = tls
        secret = radsec
        # No require_message_authenticator here, deliberately: FreeRADIUS
        # never checks Message-Authenticator on packets received over
        # RadSec, whatever this client or the global setting says. TLS 1.3
        # already authenticates every packet, and an HMAC keyed with the
        # public secret "radsec" would add nothing. The attribute defends
        # plain UDP RADIUS against forged packets (BlastRADIUS,
        # CVE-2024-3596), which cannot happen inside TLS.
        nas_type = other
    }
}

# 2. Test Runner / Management Subnet (for testing EAP-TLS directly via eapol_test)
client workstation_test {
    ipaddr = 10.10.10.0/24
    secret = $ENV{RADIUS_SECRET_TEST}
    require_message_authenticator = yes
    nas_type = other
}
