# Ignore private keys, certificates, and PKCS#12 bundles
*.key
*.p12
*.pfx
*.pem
*.crt
scratch_certs_backup/


# Ignore secret files and environment configs
.radius_secret
*.secret
.env
*.env
.env.*
certs.env

# Ignore active local client config and authorization containing live network specifics
k8s/config/clients.conf
k8s/config/authorize

# Ignore temporary files and packet captures
.DS_Store
*.pcap
*.pcapng

